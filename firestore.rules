rules_version = '2';

// Momentum 사이트용 Firestore 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 파일 내용을 통째로 붙여넣고 [게시]를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@momentum.team';
    }
    function isSchedule() {
      return request.auth != null && request.auth.token.email in ['schedule@momentum.team', 'admin@momentum.team'];
    }

    // 관리자만 쓰는 것: 공지, 영상, 선수, 기사(+기사 파일), 시즌별 팀 로고, STATS에서 숨길 선수
    match /news/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /videos/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /members/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /articles/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /articleFiles/{id} { allow read: if true; allow write: if isAdmin(); }
    match /teamLogos/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /statHidden/{id}   { allow read: if true; allow write: if isAdmin(); }

    // 일정: 일정 관리 비번 또는 관리자 비번
    match /events/{id} { allow read: if true; allow write: if isSchedule(); }

    // 응원 글: 누구나 남길 수 있고(짧은 글만), 지우기·고치기는 관리자만
    match /cheers/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['target', 'season', 'player', 'name', 'text', 'createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 100
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 20));
      allow update, delete: if isAdmin();
    }

    // 기사 조회수: 누구나 1씩만 올릴 수 있어요. 지우거나 숫자를 마음대로 바꾸는 건 관리자만.
    match /articleViews/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if isAdmin();
    }
  }
}
